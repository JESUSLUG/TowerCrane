PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=towercrane
DB_PASSWORD=towercrane
DB_NAME=towercrane
# disable for a local database; verify-full for a remote one
DB_SSLMODE=disable
# Signs sessions: anyone who knows it can sign in as any user. Random, 32+
# characters (TowerCrane refuses to start otherwise): openssl rand -base64 48
JWT_SECRET=
LOG_LEVEL=debug

# Comma-separated GitHub logins and/or emails that are always TowerCrane
# admins. This is how the first admin is created (and a way back in if every
# admin is locked out). Other roles are managed from the Team page.
TOWERCRANE_ADMINS=

# First run: TowerCrane prints a one-time setup token in its logs to create
# the first admin at FRONTEND_URL/setup. Set this to choose the token yourself.
TOWERCRANE_SETUP_TOKEN=

# Required. Key used to encrypt stored secrets (cloud access keys, GitHub
# tokens), separate from JWT_SECRET. 32 bytes, base64:
#   openssl rand -base64 32
TOWERCRANE_ENCRYPTION_KEY=

# GitHub App (connect orgs/repos, PR checks). See docs/GITHUB_APP_SETUP.md
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The app's private key on one line, with \n for line breaks:
#   awk 'NF {printf "%s\\n", $0}' your-app.private-key.pem
# In the cloud, load it from a secret store (e.g. AWS Secrets Manager).
# Alternatively GITHUB_APP_PRIVATE_KEY_PATH can point to a mounted file.
GITHUB_APP_PRIVATE_KEY=
# Webhooks are paused (TowerCrane polls GitHub): leave empty.
GITHUB_WEBHOOK_SECRET=

# GitHub OAuth2 (sign in with GitHub)
GITHUB_CLIENT_ID=your-github-oauth-app-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-secret
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
GITHUB_ORG=your-github-organization

# Frontend (also the only browser origin allowed to call the API; extra
# origins, comma-separated, in TOWERCRANE_CORS_ORIGINS)
FRONTEND_URL=http://localhost:5173

# How long one tofu/terraform/terragrunt command may run (Go duration).
TOWERCRANE_RUN_TIMEOUT=2h

# Only if TowerCrane sits behind a reverse proxy: its addresses, comma-separated
# (otherwise X-Forwarded-For is ignored).
TOWERCRANE_TRUSTED_PROXIES=
